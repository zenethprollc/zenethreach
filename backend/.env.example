# ============================================================
# ZENETH REACH AI — BACKEND ENVIRONMENT
# ============================================================
# Copy this file to `.env` and fill in the real values.
#   cp .env.example .env
# See docs/SETUP_ACCOUNTS.md for where to get each key.
# NEVER commit your real .env — only this template is tracked.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# URL of the Next.js frontend (used for CORS + OAuth redirects)
FRONTEND_URL=http://localhost:3000

# ── Supabase (database + auth) ──────────────────────────────
# Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key — used to verify end-user JWTs
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key — full DB access for server-side modules. KEEP SECRET.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Anthropic (Claude AI — brand extraction + content gen) ──
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxx

# ── NewsAPI (trend engine) ──────────────────────────────────
NEWSAPI_KEY=your-newsapi-key
# Optional: RiteTag for hashtag scoring (leave blank to skip)
RITETAG_API_KEY=

# ── Buffer (social publishing) ──────────────────────────────
# buffer.com/developers > Create an app
BUFFER_CLIENT_ID=your-buffer-client-id
BUFFER_CLIENT_SECRET=your-buffer-client-secret
BUFFER_REDIRECT_URI=http://localhost:4000/api/channels/buffer/callback

# ── Canva (automatic graphic generation) ───────────────────
# canva.com/developers — Connect API (requires app approval)
CANVA_CLIENT_ID=your-canva-client-id
CANVA_CLIENT_SECRET=your-canva-client-secret
CANVA_REDIRECT_URI=http://localhost:4000/api/canva/callback

# ── Resend (transactional email notifications) ─────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=notifications@yourdomain.com

# ── OneSignal (push notifications) ──────────────────────────
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_API_KEY=your-onesignal-rest-api-key
