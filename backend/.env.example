# ============================================================
# Zeneth Reach AI — Backend environment variables
# Copy this file to `.env` and fill in every value below.
#   cp backend/.env.example backend/.env
# ============================================================

# ── Server ──────────────────────────────────────────────────
# Port the API server listens on (default 4000).
PORT=4000
# Environment: development | production
NODE_ENV=development
# Public URL of the frontend. Used for CORS and OAuth redirects.
FRONTEND_URL=http://localhost:3000

# ── Supabase (database + auth) ──────────────────────────────
# From Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
# Public anon key — used to verify end-user JWTs.
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key — full DB access for backend automation.
# KEEP SECRET. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Anthropic (Claude AI — brand scan + content generation) ─
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key

# ── NewsAPI (trend engine) ──────────────────────────────────
# https://newsapi.org → Get API Key
NEWSAPI_KEY=your-newsapi-key
# Optional: RiteTag for hashtag enrichment. Leave blank to skip.
RITETAG_API_KEY=

# ── Buffer (social publishing) ──────────────────────────────
# https://buffer.com/developers/apps
BUFFER_CLIENT_ID=your-buffer-client-id
BUFFER_CLIENT_SECRET=your-buffer-client-secret
# Must exactly match the redirect URI registered in your Buffer app.
BUFFER_REDIRECT_URI=http://localhost:4000/api/channels/buffer/callback

# ── Canva (design generation) ───────────────────────────────
# https://www.canva.com/developers
CANVA_CLIENT_ID=your-canva-client-id
CANVA_CLIENT_SECRET=your-canva-client-secret
CANVA_REDIRECT_URI=http://localhost:4000/api/canva/callback

# ── Resend (transactional email notifications) ──────────────
# https://resend.com → API Keys
RESEND_API_KEY=your-resend-api-key
# Verified sender address for outgoing notification emails.
FROM_EMAIL=notifications@zenethpro.com

# ── OneSignal (push notifications) ──────────────────────────
# https://onesignal.com → Settings → Keys & IDs
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_API_KEY=your-onesignal-rest-api-key
