# ============================================================
# Zeneth Reach AI — Frontend environment variables
# Copy this file to `.env.local` and fill in every value below.
#   cp frontend/.env.example frontend/.env.local
#
# NOTE: All NEXT_PUBLIC_* vars are exposed to the browser.
# Never put secret keys (service role keys, client secrets) here.
# ============================================================

# Base URL of the backend API server.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase project URL and public anon key (browser auth client).
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
